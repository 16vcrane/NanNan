<cover-view class="tab-bar">
  <cover-view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <cover-image
      class="tab-icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
    />
    <cover-view
      class="tab-label"
      style="color: {{selected === index ? selectedColor : color}};"
    >{{item.text}}</cover-view>
  </cover-view>
</cover-view>
