.mood-control {
  width: 100%;
  box-sizing: border-box;
}

.mood-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mood-question {
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.mood-hint {
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.mood-stage {
  margin-top: 22rpx;
  padding: 14rpx 20rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(120, 139, 115, 0.18);
  border-radius: 22rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.48);
}

.mood-arc {
  position: relative;
  width: 100%;
  max-width: 500rpx;
  height: 242rpx;
  margin: 6rpx auto 0;
  overflow: hidden;
  touch-action: none;
}

.arc-ring,
.arc-inner {
  position: absolute;
  left: 50%;
  border-radius: 50%;
  transform: translateX(-50%);
}

.arc-ring {
  top: 0;
  width: 460rpx;
  height: 460rpx;
  filter: saturate(0.88);
  background: conic-gradient(
    from 270deg,
    #8F88C9 0deg 34deg,
    #6EA7C8 38deg 70deg,
    #79A985 74deg 106deg,
    #D6AF58 110deg 142deg,
    #D87958 146deg 180deg,
    transparent 180deg 360deg
  );
}

.arc-inner {
  top: 28rpx;
  width: 404rpx;
  height: 404rpx;
}

.arc-guide {
  width: 320rpx;
  height: 320rpx;
  position: absolute;
  top: 70rpx;
  left: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(140, 106, 80, 0.34);
  border-radius: 50%;
  transform: translateX(-50%);
}

.arc-knob {
  position: absolute;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid rgba(73, 51, 38, 0.45);
  border-radius: 50%;
  background: #FFF9F1;
  box-shadow: 0 5rpx 16rpx rgba(61, 44, 27, 0.22), 0 0 0 5rpx rgba(255, 253, 249, 0.76);
  transform: translate(-50%, -50%);
}

.arc-knob-core {
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
}

.mood-scale {
  min-height: 54rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: center;
  margin-top: -4rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.mood-current {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
}

.mood-current-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }

.mood-scale text:last-child {
  text-align: right;
}

.mood-value {
  font-size: 34rpx;
  font-weight: 600;
}
