.today-page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  padding-right: 32rpx;
  padding-left: 32rpx;
  padding-top: 0;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  background: #FCF9F4;
}

.custom-nav {
  width: 100%;
  box-sizing: border-box;
}

.custom-nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.custom-nav-title {
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.today-tagline {
  display: block;
  margin-top: 0;
  color: var(--color-text-muted);
  font-size: 25rpx;
  line-height: 1.5;
}

.record-sheet {
  width: 100%;
  max-width: 100%;
  margin-top: 24rpx;
  margin-bottom: 0;
  padding: 28rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid #EDE2D5;
  border-radius: 28rpx;
  background: #FBF1E5;
  box-shadow: 0 12rpx 40rpx rgba(86, 60, 39, 0.08);
}

.record-date {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.calendar-mark {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  position: relative;
  border: 2rpx solid #8C6A50;
  border-radius: 9rpx;
  background: #FFF9F1;
  color: var(--color-primary);
}

.calendar-binding {
  width: 4rpx;
  height: 10rpx;
  position: absolute;
  top: -6rpx;
  border-radius: 2rpx;
  background: #8C6A50;
}
.binding-left { left: 10rpx; }
.binding-right { right: 10rpx; }
.calendar-divider { width: 100%; height: 2rpx; position: absolute; top: 12rpx; background: #D8C1AA; }
.calendar-date-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; background: #D58A61;
  box-shadow: 14rpx 0 0 #8EAE9A; transform: translateX(-7rpx);
}

.date-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.date-text {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 500;
}

.greeting-text {
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.editor-area {
  margin-top: 16rpx;
  overflow: hidden;
  border: 2rpx solid #DFD1C2;
  border-radius: 28rpx;
  background: #FFFDFC;
  box-shadow: 0 4rpx 16rpx rgba(86, 61, 40, 0.05);
}

.diary-input {
  width: 100%;
  height: 188rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  color: var(--color-text);
  font-size: 29rpx;
  line-height: 1.75;
  border-radius: 26rpx 26rpx 0 0;
  background: transparent;
}

.diary-placeholder {
  color: #A99C90;
}

.editor-meta {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 24rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-muted);
  font-size: 23rpx;
  border-radius: 0 0 26rpx 26rpx;
}

.draft-status {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.character-count {
  flex: 0 0 auto;
  font-variant-numeric: tabular-nums;
}

.save-button {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: auto 0 0;
  padding: 0 32rpx;
  box-sizing: border-box;
  background-color: #6B4933 !important;
  border: 0;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(86, 55, 34, 0.15);
  color: #FFFFFF !important;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
}

.save-button-text {
  display: block;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
}

.save-button::after {
  border: 0;
}

.save-button[disabled] {
  background-color: #CFC2B6 !important;
  box-shadow: none;
  color: #FFFDF9 !important;
  opacity: 1;
}

.save-button[disabled] .save-button-text {
  color: #FFFDF9;
}

.save-error {
  display: block;
  margin-top: 18rpx;
  color: var(--color-danger);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .record-sheet {
    padding: 20rpx;
  }
}
