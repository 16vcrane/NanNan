.profile-page {
  padding-top: 48rpx;
}

.account-panel {
  min-height: 144rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 38rpx;
  padding: 28rpx;
}

.account-mark {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.account-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.account-name {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.account-id {
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-action {
  width: 128rpx;
  height: 64rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-primary);
  border-radius: 7rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 62rpx;
}

.login-action::after { border: 0; }

.menu-list {
  margin-top: 28rpx;
  padding: 0 28rpx;
}

.menu-item {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-arrow {
  color: var(--color-text-secondary);
  font-size: 42rpx;
}

.logout-action {
  width: 100%;
  height: 78rpx;
  margin: 30rpx 0 0;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  background: transparent;
  color: var(--color-text-muted);
  font-size: 27rpx;
  line-height: 76rpx;
}

.logout-action::after { border: 0; }
