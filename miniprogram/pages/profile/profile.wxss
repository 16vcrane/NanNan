.profile-page {
  padding-top: 64rpx;
  padding-right: 48rpx;
  padding-left: 48rpx;
  background: #FCF9F4;
}

.profile-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 4rpx;
}
.profile-heading .page-subtitle { margin-top: 12rpx; }
.heading-mark {
  width: 72rpx; height: 48rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx;
  background: #FFFDFC; color: var(--color-text); font-size: 26rpx;
  line-height: 42rpx; text-align: center; letter-spacing: 2rpx;
}

.account-panel {
  min-height: 154rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 38rpx;
  padding: 26rpx 28rpx;
  border: 0;
  box-shadow: 0 8rpx 28rpx rgba(86, 61, 40, 0.06);
}

.account-mark {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: 4rpx solid #F1E3D4;
  border-radius: 50%;
  background: #F6DCC7;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.account-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.account-name {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.account-id {
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-action {
  width: 128rpx;
  height: 64rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-primary);
  border-radius: 7rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 62rpx;
}

.login-action::after { border: 0; }

.menu-list {
  margin-top: 28rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 28rpx rgba(86, 61, 40, 0.05);
}

.menu-item {
  min-height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.menu-icon {
  width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto; margin-right: 20rpx; border-radius: 14rpx;
  background: #F6EFE5; color: var(--color-primary); font-size: 23rpx; font-weight: 600;
}

.menu-label { flex: 1; }

.menu-item:last-child {
  border-bottom: 0;
}

.menu-arrow {
  color: var(--color-text-secondary);
  font-size: 42rpx;
}

.logout-action {
  width: 100%;
  height: 78rpx;
  margin: 30rpx 0 0;
  border: 1rpx solid #F3D2CB;
  border-radius: 18rpx;
  background: #FCEBE7;
  color: var(--color-danger);
  font-size: 27rpx;
  line-height: 76rpx;
}

.logout-action::after { border: 0; }
