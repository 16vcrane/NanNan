.detail-page {
  padding-top: 38rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.detail-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-line {
  width: 96rpx;
  height: 4rpx;
  overflow: hidden;
  position: relative;
  border-radius: 2rpx;
  background: var(--color-primary-soft);
}

.loading-line::after {
  content: '';
  width: 36rpx;
  height: 100%;
  position: absolute;
  left: 0;
  background: var(--color-primary);
  animation: loading 1.2s infinite ease-in-out;
}

@keyframes loading {
  0% { transform: translateX(-36rpx); }
  100% { transform: translateX(96rpx); }
}

.state-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.retry-action {
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: 8rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 70rpx;
}

.retry-action::after { border: 0; }

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.date-text {
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.mood-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.mood-dot {
  width: 11rpx;
  height: 11rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.diary-section {
  padding: 38rpx 0 12rpx;
}

.diary-content {
  display: block;
  color: var(--color-text);
  font-size: 31rpx;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 30rpx;
}

.image-grid-1 { grid-template-columns: minmax(0, 1fr); }
.image-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.detail-image-wrap {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 6rpx;
  background: #eee5dc;
}

.image-grid-1 .detail-image-wrap { aspect-ratio: 16 / 10; }

.detail-image,
.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-placeholder {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.marker-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 30rpx;
}

.marker {
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  border: 1rpx solid;
  border-radius: 6rpx;
  background: #fffdf9;
  font-size: 22rpx;
  line-height: 44rpx;
}

.marker-pin {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.reflection-section {
  margin-top: 54rpx;
}

.section-label {
  display: block;
  margin-bottom: 18rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.delete-action {
  width: 100%;
  height: 80rpx;
  margin: 48rpx 0 0;
  border: 1rpx solid rgba(169, 79, 69, 0.45);
  border-radius: 8rpx;
  background: transparent;
  color: var(--color-danger);
  font-size: 27rpx;
  line-height: 78rpx;
}

.delete-action::after { border: 0; }
