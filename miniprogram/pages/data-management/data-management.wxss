.data-page { padding-top: 48rpx; }

.data-section,
.danger-section {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.data-section:first-of-type { margin-top: 28rpx; }

.data-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.data-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text-muted);
  font-size: 27rpx;
  line-height: 1.8;
}

.danger-section { border-bottom: 0; }
.danger-title { color: var(--color-danger); }

.delete-all-action,
.login-data-action {
  width: 100%;
  height: 80rpx;
  margin: 32rpx 0 0;
  border-radius: 8rpx;
  background: transparent;
  font-size: 27rpx;
  line-height: 78rpx;
}

.delete-all-action {
  border: 1rpx solid rgba(169, 79, 69, 0.55);
  color: var(--color-danger);
}

.login-data-action {
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
}

.delete-all-action::after,
.login-data-action::after { border: 0; }
