.data-page {
  padding-top: 64rpx;
  padding-right: 48rpx;
  padding-left: 48rpx;
  background: #F5F6F3;
}

.data-section,
.danger-section {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #DCE5DC;
  border-radius: 18rpx;
  background: #FBFDF9;
}

.data-section:first-of-type { margin-top: 34rpx; }
.data-section:nth-of-type(2) { border-color: #DCE4EA; background: #F9FCFD; }

.data-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.data-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text-muted);
  font-size: 27rpx;
  line-height: 1.8;
}

.danger-section { border-color: #EBCFC9; background: #FDF4F1; }
.danger-title { color: var(--color-danger); }

.delete-all-action,
.login-data-action {
  width: 100%;
  height: 80rpx;
  margin: 32rpx 0 0;
  border-radius: 14rpx;
  background: transparent;
  font-size: 27rpx;
  line-height: 78rpx;
}

.delete-all-action {
  border: 1rpx solid rgba(169, 79, 69, 0.55);
  color: var(--color-danger);
}

.login-data-action {
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
}

.delete-all-action::after,
.login-data-action::after { border: 0; }
